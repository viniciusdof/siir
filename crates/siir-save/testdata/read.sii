    data_path: "/def/vehicle/truck/test.model/data.sii"
}
vehicle_accessory : accessory.engine {
    data_path: "/def/vehicle/truck/test.model/engine/500.sii"
}
trailer : trailer.one {
    trailer_definition: trailer_def.test
    cargo_mass: 1000
    slave_trailer: null
    license_plate: "TEST"
    trailer_body_wear: &3f800000
    chassis_wear: 0.5
}
garage : garage.one {
    status: 2
}
driver_ai : driver.one {
    experience_points: 10
}
company : company.one {
    permanent_data: company.permanent.test
}
job_info : job.one {
    cargo: null
    planned_distance_km: 0
}
player_job : player_job.one {
    cargo: cargo.stone
    source_company: company.a
    target_company: company.b
    planned_distance_km: 12
}
job_offer_data : offer.one {
    target: "city.name"
    cargo: cargo.stone
    shortest_distance_km: 7
}
used_truck_offer : used.one {
    truck: vehicle.one
    price: 100
}
