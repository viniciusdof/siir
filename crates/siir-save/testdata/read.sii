SiiNunit
{
economy : economy {
    bank: bank.one
    player: player.one
}
bank : bank.one {
    money_account: 500
}
player : player.one {
    hq_city: prague
    my_vehicles: 1
    my_vehicles[0]: slot.one
    trucks: 1
    trucks[0]: vehicle.one
    trailers: 1
    trailers[0]: trailer.one
    assigned_vehicles: slot.one
    current_job: player_job.one
}
player_vehicles : slot.one {
    vehicle: vehicle.one
    trailer: trailer.one
    stored_vehicle_placement: (1, 2, 3) (1; 0, 0, 0)
}
player_vehicles : slot.two {
    vehicle: vehicle.one
}
vehicle : vehicle.one {
    engine_wear: &3f800000
    transmission_wear: 0.5
    cabin_wear: 0
    fuel_relative: 1
    accessories: 2
    accessories[0]: accessory.data
    accessories[1]: accessory.engine
}
